# AI Relay — configuration sample.
# Copy to ~/.airelay/config.properties (or point AIRELAY_CONFIG at it).
# Every key here can also be set as an env var: AIRELAY_ + KEY, dots -> underscores,
# upper-cased (e.g. gemini.api.key -> AIRELAY_GEMINI_API_KEY). Env vars win.
#
# Claude needs nothing here — it reuses the `claude` CLI's own login.
# Copilot's keys are written by `airelay copilot setup`, not by hand — see the end.

# Which Gemini transport: gemini-api | vertex | apigee
gemini.mode=gemini-api
gemini.model=gemini-2.5-pro

# --- gemini-api mode ---
gemini.api.key=

# --- vertex mode (and shared by apigee) ---
vertex.project=
vertex.location=us-central1
# gcloud.path=/opt/homebrew/bin/gcloud

# --- apigee mode (Vertex behind a custom Apigee OAuth gateway) ---
vertex.endpoint=
apigee.token.url=
apigee.client.id=
apigee.client.secret=

# --- copilot ---
# Written by `airelay copilot setup` from a request captured in your browser;
# there is nothing to fill in by hand. Listed here so you know what's in the file.
#
#   copilot.endpoint           the URL the web app posts to
#   copilot.method             usually POST
#   copilot.headers            the captured headers, as JSON — INCLUDES YOUR SESSION TOKEN
#   copilot.body               the captured request body, used as a template
#   copilot.body.json          whether that body is JSON (else placeholder substitution)
#   copilot.prompt.path        where the prompt goes, e.g. messages/0/content
#   copilot.model.path         where the model id goes, e.g. modelId
#   copilot.conversation.path  where the conversation id goes
#   copilot.conversation.id    the conversation to continue
#   copilot.model              the selected model
#   copilot.models             comma-separated ids offered by /model
#   copilot.history            server (default) | local
#
# Two you may want to set yourself when a reply comes back empty:
# copilot.text.keys=speak,answer
# copilot.debug=true

# --- misc ---
command.timeout.seconds=300
