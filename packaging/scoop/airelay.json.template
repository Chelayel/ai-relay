{
    "version": "@VERSION@",
    "description": "Claude, Gemini and Copilot as CLI coding agents",
    "homepage": "https://github.com/Chelayel/ai-relay",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Chelayel/ai-relay/releases/download/v@VERSION@/airelay-windows-x64.zip",
            "hash": "@SHA_WINDOWS_X64@",
            "extract_dir": "airelay"
        }
    },
    "bin": "airelay.exe",
    "post_install": [
        "foreach ($o in @(\"$env:LOCALAPPDATA\\Programs\\airelay\\airelay.exe\", \"$env:LOCALAPPDATA\\airelay\\airelay.exe\")) {",
        "  if (Test-Path $o) { Write-Host \"Note: another airelay is installed at $o. Whichever comes first on your PATH runs; remove that one if you no longer want it (install.ps1: delete its folder and PATH entry; the .msi: Settings > Apps > Installed apps).\" }",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Chelayel/ai-relay/releases/download/v$version/airelay-windows-x64.zip"
            }
        }
    }
}
